; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aniversário"
config/description="Um pequeno jogo narrativo."
run/main_scene="res://scenes/casa/casa.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.227451, 0.141176, 0.172549, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

